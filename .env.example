# Neon Postgres bağlantı dizesi. Vercel Marketplace'ten Neon eklenince
# otomatik gelir; yerelde `vercel env pull .env.local` ile çek.
DATABASE_URL=

# Oturum imzası, en az 32 karakter rastgele metin.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Kullanıcılar (kayıt kapalı). Her biri için: node scripts/hash-password.mjs ad@firma.com
# Biçim: eposta:scrypt:<salt>:<hash>;eposta2:scrypt:<salt>:<hash>
AUTH_USERS=
